# ── Database ──────────────────────────────────────────────────────────────────
# Used by the FastAPI app inside Docker (db = service name)
DATABASE_URL=postgresql://postgres:mypassword@db:5432/multi_agent_db
# Used by local scripts, eval, and Alembic migrations (localhost + host port)
# DATABASE_URL=postgresql://postgres:mypassword@localhost:5433/multi_agent_db

SESSION_EXPIRY_MINUTES=60

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ── LangSmith ─────────────────────────────────────────────────────────────────
# Get your API key at https://smith.langchain.com → Settings → API Keys
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=lsv2_pt_...
LANGCHAIN_PROJECT=multi-agent-ecommerce

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_PROJECT=multi-agent-ecommerce
