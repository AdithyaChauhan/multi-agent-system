{
  "id": 1,
  "panels": [
    {
      "description": "Chat API requests per minute",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "reqpm"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(http_requests_total{endpoint=\"/chat\"}[1m]) * 60",
          "legendFormat": "requests/min"
        }
      ],
      "title": "Request Volume Over Time",
      "type": "timeseries"
    },
    {
      "description": "How often each agent is selected by the router",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "displayLabels": [
          "name",
          "percent"
        ],
        "pieType": "pie"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "increase(agent_requests_total{agent=\"order\"}[1h])",
          "legendFormat": "Order"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "increase(agent_requests_total{agent=\"product\"}[1h])",
          "legendFormat": "Product"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "increase(agent_requests_total{agent=\"support\"}[1h])",
          "legendFormat": "Support"
        }
      ],
      "title": "Agent Selection Distribution",
      "type": "piechart"
    },
    {
      "description": "Average LLM API call duration per agent, scraped from /metrics",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "ms"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(llm_duration_seconds_sum[5m]) / rate(llm_duration_seconds_count[5m]) * 1000",
          "legendFormat": "{{agent}} / {{node}}"
        }
      ],
      "title": "Average LLM Latency Per Agent (ms)",
      "type": "timeseries"
    },
    {
      "description": "HTTP 4xx and 5xx responses per minute",
      "fieldConfig": {
        "defaults": {
          "color": {
            "fixedColor": "red",
            "mode": "fixed"
          },
          "unit": "reqpm"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(http_requests_total{status_code=~\"[45]..\"}[1m]) * 60",
          "legendFormat": "{{status_code}} errors/min"
        }
      ],
      "title": "Error Rate Over Time",
      "type": "timeseries"
    },
    {
      "description": "Tokens consumed per agent per minute, scraped from /metrics",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "id": 5,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(llm_tokens_total{token_type=\"total\"}[1m]) * 60",
          "legendFormat": "{{agent}} total tokens/min"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(llm_tokens_total{token_type=\"prompt\"}[1m]) * 60",
          "legendFormat": "{{agent}} prompt tokens/min"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(llm_tokens_total{token_type=\"completion\"}[1m]) * 60",
          "legendFormat": "{{agent}} completion tokens/min"
        }
      ],
      "title": "LLM Token Consumption Over Time",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Filter by request_id, agent (e.g. app.agents.router), or level (INFO / ERROR)",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "id": 6,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"multiagent-app\", filename=\"/logs/app.log\"}",
          "legendFormat": ""
        }
      ],
      "title": "Application Logs",
      "type": "logs"
    },
    {
      "id": 100,
      "type": "row",
      "title": "Demo never breaks",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "panels": []
    },
    {
      "id": 101,
      "type": "timeseries",
      "title": "Chat turn latency (s)",
      "description": "Start of a chat turn to its reply, /chat and /chat/stream. The red line is the 3 s target.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(chat_turn_seconds_bucket[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(chat_turn_seconds_bucket[5m])))",
          "legendFormat": "median",
          "refId": "B"
        }
      ]
    },
    {
      "id": 102,
      "type": "timeseries",
      "title": "Chat turns by outcome (per minute)",
      "description": "answered; busy = no model in the fallback chain could answer; limited = per-user limits; refused; error.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 35
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 25,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (outcome) (rate(chat_turns_total[1m])) * 60",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 103,
      "type": "timeseries",
      "title": "Model fallbacks (per minute)",
      "description": "Calls a model couldn't answer (rate limit, unreachable, server error, retired), so the next model in the chain did.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 43
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (from_model, reason) (rate(llm_fallback_total[5m])) * 60",
          "legendFormat": "{{from_model}}: {{reason}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(llm_unavailable_total[5m])) * 60",
          "legendFormat": "no model could answer",
          "refId": "B"
        }
      ]
    },
    {
      "id": 104,
      "type": "timeseries",
      "title": "Answer cache hit rate",
      "description": "Model calls answered from the in-memory cache (identical calls within LLM_CACHE_SECONDS).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 43
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(llm_cache_hits_total[5m])) / clamp_min(sum(rate(llm_cache_hits_total[5m])) + sum(rate(llm_requests_total[5m])), 1e-9)",
          "legendFormat": "hit rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 105,
      "type": "timeseries",
      "title": "Limited turns (per minute)",
      "description": "Turns refused by the per-minute rate or the daily turn budget.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 43
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (limit) (rate(chat_limited_total[1m])) * 60",
          "legendFormat": "{{limit}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 36,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "title": "Multi-Agent E-commerce Dashboard",
  "uid": "multiagent-ecommerce",
  "version": 1
}
