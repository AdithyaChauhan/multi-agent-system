{
  "id": null,
  "uid": "multiagent-ecommerce",
  "title": "Multi-Agent E-commerce Dashboard",
  "schemaVersion": 36,
  "version": 3,
  "panels": [
    {
      "id": 1,
      "title": "Request Volume Over Time",
      "description": "Chat API requests per minute",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "fieldConfig": {
        "defaults": {"unit": "reqpm", "color": {"mode": "palette-classic"}}
      },
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "rate(http_requests_total{endpoint=\"/chat\"}[1m]) * 60",
        "legendFormat": "requests/min"
      }]
    },
    {
      "id": 2,
      "title": "Agent Selection Distribution",
      "description": "How often each agent is selected by the router",
      "type": "piechart",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "options": {"pieType": "pie", "displayLabels": ["name", "percent"]},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "agent_requests_total{agent=\"order\"}",
          "legendFormat": "Order"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "agent_requests_total{agent=\"product\"}",
          "legendFormat": "Product"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "agent_requests_total{agent=\"support\"}",
          "legendFormat": "Support"
        }
      ]
    },
    {
      "id": 3,
      "title": "Average LLM Latency Per Agent (ms)",
      "description": "Average LLM API call duration per agent, scraped from /metrics",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "fieldConfig": {
        "defaults": {"unit": "ms", "color": {"mode": "palette-classic"}}
      },
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "rate(llm_duration_seconds_sum[5m]) / rate(llm_duration_seconds_count[5m]) * 1000",
        "legendFormat": "{{agent}} / {{node}}"
      }]
    },
    {
      "id": 4,
      "title": "Error Rate Over Time",
      "description": "HTTP 4xx and 5xx responses per minute",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "color": {"mode": "fixed", "fixedColor": "red"}
        }
      },
      "targets": [{
        "datasource": {"type": "prometheus", "uid": "prometheus"},
        "expr": "rate(http_requests_total{status_code=~\"[45]..\"}[1m]) * 60",
        "legendFormat": "{{status_code}} errors/min"
      }]
    },
    {
      "id": 5,
      "title": "LLM Token Consumption Over Time",
      "description": "Tokens consumed per agent per minute, scraped from /metrics",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "fieldConfig": {
        "defaults": {"unit": "short", "color": {"mode": "palette-classic"}}
      },
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(rate(llm_tokens_total{token_type=\"total\"}[1m])) by (agent) * 60",
          "legendFormat": "{{agent}} total"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(rate(llm_tokens_total{token_type=\"prompt\"}[1m])) by (agent) * 60",
          "legendFormat": "{{agent}} prompt"
        },
        {
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(rate(llm_tokens_total{token_type=\"completion\"}[1m])) by (agent) * 60",
          "legendFormat": "{{agent}} completion"
        }
      ]
    },
    {
      "id": 6,
      "title": "Application Logs",
      "description": "Filter by request_id, agent (e.g. app.agents.router), or level (INFO / ERROR)",
      "type": "logs",
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 24},
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [{
        "datasource": {"type": "loki", "uid": "loki"},
        "expr": "{job=\"multiagent-app\"} | pattern `<_> | <level> | <service> | <_>`",
        "legendFormat": ""
      }]
    }
  ],
  "time": {"from": "now-6h", "to": "now"},
  "refresh": "30s"
}
